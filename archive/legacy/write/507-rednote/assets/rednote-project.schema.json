{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/rednote/rednote-project.schema.json",
  "title": "Rednote Article or Visual Summary Project",
  "type": "object",
  "required": ["mode", "title", "visualSystem", "themePreset", "excludedContent", "pages"],
  "additionalProperties": false,
  "properties": {
    "mode": {"enum": ["article", "summary"]},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "avatar": {"type": "string"},
    "visualSystem": {"enum": ["editorial", "swiss"]},
    "themePreset": {"enum": ["editorial-paper", "editorial-night", "swiss-blue", "swiss-red"]},
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": {"$ref": "#/$defs/color"},
        "paperAlt": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "accentDark": {"$ref": "#/$defs/color"},
        "line": {"$ref": "#/$defs/color"}
      }
    },
    "excludedContent": {
      "type": "array",
      "items": {"$ref": "#/$defs/excludedItem"}
    },
    "pages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20
    },
    "wechatCovers": {
      "type": "object",
      "required": ["main", "share"],
      "additionalProperties": false,
      "properties": {
        "main": {"$ref": "#/$defs/wechatCover"},
        "share": {"$ref": "#/$defs/wechatCover"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "summary"}}},
      "then": {
        "properties": {
          "pages": {
            "prefixItems": [{"$ref": "#/$defs/coverPage"}],
            "items": {"$ref": "#/$defs/articlePage"}
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "article"}}},
      "then": {
        "properties": {
          "excludedContent": {"maxItems": 0},
          "pages": {
            "prefixItems": [{"$ref": "#/$defs/coverPage"}],
            "items": {"$ref": "#/$defs/articleFlowPage"}
          }
        }
      }
    }
  ],
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "imagePosition": {
      "enum": ["center", "top", "bottom", "left", "right", "center top", "center bottom", "left center", "right center"]
    },
    "excludedItem": {
      "type": "object",
      "required": ["summary", "destination"],
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "reason": {"type": "string"},
        "destination": {"enum": ["postBody", "companionCopy", "series", "notUsed"]}
      }
    },
    "coverPage": {
      "type": "object",
      "required": ["type", "point", "sourceMap", "layout", "title"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cover"},
        "point": {"type": "string", "minLength": 1},
        "sourceMap": {"type": "string", "minLength": 1},
        "layout": {"enum": ["type", "split", "image-led"]},
        "kicker": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "author": {"type": "string"},
        "image": {"type": "string"},
        "imagePosition": {"$ref": "#/$defs/imagePosition"}
      }
    },
    "wechatCover": {
      "type": "object",
      "required": ["point", "sourceMap", "layout", "title"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cover"},
        "point": {"type": "string", "minLength": 1},
        "sourceMap": {"type": "string", "minLength": 1},
        "layout": {"enum": ["type", "split", "image-led"]},
        "kicker": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "author": {"type": "string"},
        "image": {"type": "string"},
        "imagePosition": {"$ref": "#/$defs/imagePosition"}
      }
    },
    "articlePage": {
      "type": "object",
      "required": ["type", "point", "sourceMap", "layout", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "article"},
        "point": {"type": "string", "minLength": 1},
        "sourceMap": {"type": "string", "minLength": 1},
        "layout": {"enum": ["statement", "evidence", "comparison", "steps", "list", "data", "closing"]},
        "heading": {"type": "string", "minLength": 1},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}
      }
    },
    "articleFlowPage": {
      "type": "object",
      "required": ["type", "sourceMap", "blocks"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "article"},
        "sourceMap": {"type": "string", "minLength": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/articleFlowBlock"}
        }
      }
    },
    "block": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/headingBlock"},
        {"$ref": "#/$defs/listBlock"},
        {"$ref": "#/$defs/textBlock"},
        {"$ref": "#/$defs/imageBlock"},
        {"$ref": "#/$defs/screenshotBlock"},
        {"$ref": "#/$defs/motionBlock"},
        {"$ref": "#/$defs/cardsBlock"},
        {"$ref": "#/$defs/sequenceBlock"}
      ]
    },
    "articleFlowBlock": {
      "oneOf": [
        {"$ref": "#/$defs/paragraph"},
        {"$ref": "#/$defs/headingBlock"},
        {"$ref": "#/$defs/listBlock"},
        {"$ref": "#/$defs/textBlock"},
        {"$ref": "#/$defs/imageBlock"},
        {"$ref": "#/$defs/screenshotBlock"},
        {"$ref": "#/$defs/motionBlock"}
      ]
    },
    "paragraph": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "paragraph"},
        "text": {"type": "string", "minLength": 1},
        "variant": {"enum": ["body", "lead", "big", "muted"]}
      }
    },
    "headingBlock": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "heading"},
        "text": {"type": "string", "minLength": 1},
        "level": {"enum": [2, 3]}
      }
    },
    "listBlock": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "list"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1}
        },
        "ordered": {"type": "boolean"}
      }
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["note", "quote"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "image"},
        "src": {"type": "string", "minLength": 1},
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "height": {"type": "integer", "minimum": 120, "maximum": 620},
        "fit": {"enum": ["contain", "cover"]},
        "position": {"$ref": "#/$defs/imagePosition"}
      }
    },
    "screenshotBlock": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "screenshot"},
        "src": {"type": "string", "minLength": 1},
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "height": {"type": "integer", "minimum": 120, "maximum": 620},
        "chrome": {"enum": ["none", "browser", "phone"]},
        "fit": {"enum": ["contain", "cover"]},
        "position": {"$ref": "#/$defs/imagePosition"}
      }
    },
    "motionBlock": {
      "type": "object",
      "required": ["type", "src", "durationSec"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "motion"},
        "src": {"type": "string", "minLength": 1},
        "alt": {"type": "string"},
        "caption": {"type": "string"},
        "height": {"type": "integer", "minimum": 120, "maximum": 620},
        "fit": {"enum": ["contain", "cover"]},
        "position": {"$ref": "#/$defs/imagePosition"},
        "startSec": {"type": "number", "minimum": 0},
        "durationSec": {"type": "number", "minimum": 1, "maximum": 5},
        "posterTimeSec": {"type": "number", "minimum": 0}
      }
    },
    "cardsBlock": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cards"},
        "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "sequenceBlock": {
      "type": "object",
      "required": ["type", "items"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["flow", "timeline"]},
        "items": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {"type": "string"},
        "title": {"type": "string"},
        "text": {"type": "string"},
        "tone": {"enum": ["green", "blue", "purple", "red"]}
      },
      "anyOf": [{"required": ["title"]}, {"required": ["text"]}]
    }
  }
}
